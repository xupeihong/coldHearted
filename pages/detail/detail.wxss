.hero {
  border-radius: 24rpx;
  padding: 44rpx 36rpx 34rpx;
  color: #FFFFFF;
  background: linear-gradient(140deg, #B23A3A 0%, #98302F 100%);
  box-shadow: 0 10rpx 28rpx rgba(178, 58, 58, 0.22);
}

.hero-out {
  background: linear-gradient(140deg, #3F7D53 0%, #336746 100%);
  box-shadow: 0 10rpx 28rpx rgba(63, 125, 83, 0.22);
}

.hero-done {
  opacity: 0.72;
}

.hero-name {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero-amount {
  font-size: 76rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin: 12rpx 0 20rpx;
}

.hero-tags {
  display: flex;
}

.hero-tag {
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-right: 14rpx;
}

.hero-hint {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.66);
}

/* ------------------------------ 信息行 ------------------------------ */

.row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F1EAE1;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  flex: none;
  width: 140rpx;
  font-size: 26rpx;
  color: #9A9086;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  color: #2E2A26;
  word-break: break-all;
}

/* ------------------------------ 凭证 ------------------------------ */

.proof {
  width: 100%;
  border-radius: 16rpx;
  background: #F1EAE1;
}

.proof-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #A69C90;
  background: #FDFBF8;
  border-radius: 16rpx;
}

/* ------------------------------ 操作 ------------------------------ */

.actions {
  margin-top: 40rpx;
}

.actions button + button {
  margin-top: 22rpx;
}

/* ------------------------------ 异常 ------------------------------ */

.error-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.error-text {
  color: #B23A3A;
  font-size: 26rpx;
  margin-bottom: 26rpx;
}

.error-btn {
  display: inline-block;
  font-size: 27rpx;
  color: #B23A3A;
  border: 2rpx solid #E3D6CC;
  border-radius: 999rpx;
  padding: 14rpx 44rpx;
}
