.overview {
  background: linear-gradient(140deg, #4A433C 0%, #35302A 100%);
  border-radius: 24rpx;
  padding: 32rpx 32rpx 24rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(74, 67, 60, 0.2);
}

.overview-row {
  display: flex;
  align-items: stretch;
}

.overview-item {
  flex: 1;
  min-width: 0;
}

.overview-split {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.18);
  margin: 0 30rpx;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.overview-value {
  font-size: 44rpx;
  font-weight: 600;
  margin-top: 8rpx;
  color: #F3D9AE;
}

.overview-foot {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.14);
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.66);
}

/* ------------------------------ 人员条目 ------------------------------ */

.person {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-top: 22rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 18rpx rgba(122, 96, 66, 0.06);
}

.person-head {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
}

.person-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 50%;
  background: #FBEDEB;
  color: #B23A3A;
  font-size: 32rpx;
  text-align: center;
  margin-right: 22rpx;
}

.person-main {
  flex: 1;
  min-width: 0;
}

.person-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #2E2A26;
  display: flex;
  align-items: center;
}

.person-relation {
  font-size: 21rpx;
  font-weight: 400;
  color: #9A9086;
  background: #F5F1EA;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin-left: 14rpx;
}

.person-meta {
  font-size: 23rpx;
  color: #9A9086;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-net {
  flex: none;
  text-align: right;
  margin-left: 18rpx;
}

.person-net-label {
  font-size: 21rpx;
  color: #9A9086;
}

.person-net-amount {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.net-owe .person-net-amount {
  color: #B23A3A;
}

.net-back .person-net-amount {
  color: #3F7D53;
}

.net-flat .person-net-label {
  color: #B4AAA0;
}

.person-arrow {
  flex: none;
  width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #B4AAA0;
}

.person-records {
  padding: 8rpx 24rpx 26rpx;
  border-top: 2rpx solid #F5F1EA;
}

.person-records .rc {
  box-shadow: none;
  background: #FBF9F6;
  border-radius: 16rpx;
}

.person-empty {
  padding: 24rpx 0;
  text-align: center;
}

/* ------------------------------ 异常 ------------------------------ */

.error-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  margin-top: 24rpx;
  text-align: center;
}

.error-text {
  color: #B23A3A;
  font-size: 26rpx;
  margin-bottom: 26rpx;
}

.error-btn {
  display: inline-block;
  font-size: 27rpx;
  color: #B23A3A;
  border: 2rpx solid #E3D6CC;
  border-radius: 999rpx;
  padding: 14rpx 44rpx;
}
