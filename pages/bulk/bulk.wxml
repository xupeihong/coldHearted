<view class="page">
  <!-- 凭证照片 -->
  <view class="card">
    <view class="section-title">
      <text>整页礼金簿</text>
      <text wx:if="{{photoPath}}" class="redo" bindtap="onRemovePhoto">移除</text>
    </view>

    <block wx:if="{{photoSrc}}">
      <image class="photo" src="{{photoSrc}}" mode="aspectFit" bindtap="onPreviewPhoto" />
      <view class="photo-actions">
        <view class="photo-btn" bindtap="onChoosePhoto">换一张</view>
        <view class="photo-btn" bindtap="runRecognize">重新识别</view>
      </view>
    </block>

    <view wx:else class="photo-empty" bindtap="onChoosePhoto">
      <view class="photo-plus">＋</view>
      <view class="photo-hint">拍一页名单</view>
      <view class="tiny">一次读出这一页上的所有人名和金额，核对后再写入</view>
    </view>

    <view wx:if="{{recognizing}}" class="recognize-tip">正在逐行读这一页，人名多时请稍候…</view>
    <view wx:elif="{{recognizeMsg}}" class="recognize-tip">{{recognizeMsg}}</view>
  </view>

  <block wx:if="{{step === 'review'}}">
    <!-- 整页共同的信息 -->
    <view class="card">
      <view class="section-title">整页共同的信息</view>
      <view class="hint">这一页上的所有人共用下面的收送方向、事由和日期</view>

      <view class="seg">
        <view
          class="seg-item {{direction === 'in' ? 'seg-on' : ''}}"
          data-key="in"
          bindtap="onDirectionTap"
        >
          <view class="seg-main">收礼</view>
          <view class="seg-sub">别人给我</view>
        </view>
        <view
          class="seg-item seg-item-out {{direction === 'out' ? 'seg-on seg-on-out' : ''}}"
          data-key="out"
          bindtap="onDirectionTap"
        >
          <view class="seg-main">送礼</view>
          <view class="seg-sub">我给出去</view>
        </view>
      </view>

      <view class="field">
        <view class="field-label">事由</view>
        <view class="chips">
          <view
            wx:for="{{eventTypes}}"
            wx:key="*this"
            class="chip {{eventType === item ? 'chip-on' : ''}}"
            data-value="{{item}}"
            bindtap="onEventTap"
          >{{item}}</view>
        </view>
      </view>

      <view class="field">
        <view class="field-label">日期</view>
        <picker mode="date" value="{{happenedOn}}" bindchange="onDateChange">
          <view class="field-input picker">{{happenedOn}}</view>
        </picker>
      </view>
    </view>

    <!-- 识别质量提醒 -->
    <view wx:if="{{warnText}}" class="warn-card">{{warnText}}</view>

    <!-- 候选清单 -->
    <view class="card">
      <view class="section-title">
        <text>识别到 {{items.length}} 人 · 已选 {{selectedCount}}</text>
        <text class="redo" bindtap="onToggleAll">{{allSelected ? '全不选' : '全选'}}</text>
      </view>

      <view class="roster-head">
        <view class="roster-check"></view>
        <view class="roster-name">姓名 / 关系</view>
        <view class="roster-amount">金额</view>
      </view>

      <view wx:for="{{items}}" wx:key="key" class="roster-row">
        <view
          class="roster-check"
          data-index="{{index}}"
          bindtap="onToggleItem"
        >
          <view class="tick {{item.selected ? 'tick-on' : ''}}">{{item.selected ? '✓' : ''}}</view>
        </view>

        <view class="roster-name">
          <input
            class="roster-input {{item.name ? '' : 'roster-input-warn'}}"
            value="{{item.name}}"
            data-index="{{index}}"
            data-field="name"
            placeholder="姓名"
            placeholder-class="field-placeholder"
            bindinput="onItemInput"
          />
          <input
            class="roster-input roster-input-sub"
            value="{{item.relation}}"
            data-index="{{index}}"
            data-field="relation"
            placeholder="关系（选填，如 同事）"
            placeholder-class="field-placeholder"
            bindinput="onItemInput"
          />
        </view>

        <view class="roster-amount">
          <input
            class="roster-input roster-input-amount {{item.amountMissing ? 'roster-input-warn' : ''}}"
            type="digit"
            value="{{item.amount}}"
            data-index="{{index}}"
            data-field="amount"
            placeholder="0"
            placeholder-class="{{item.amountMissing ? 'ph-warn' : 'field-placeholder'}}"
            bindinput="onItemInput"
          />
        </view>
      </view>

      <view class="roster-foot">
        <text>合计 ¥{{totalAmountText}}</text>
        <text class="redo" bindtap="onAddRow">手动加一行</text>
      </view>
    </view>

    <button
      class="btn-primary submit"
      bindtap="onSubmit"
      loading="{{saving}}"
      disabled="{{saving}}"
    >写入 {{selectedCount}} 条记录</button>
  </block>
</view>
