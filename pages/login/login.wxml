<view class="login">
  <view class="brand">
    <view class="brand-mark">人情</view>
    <view class="brand-title">人情账簿</view>
    <view class="brand-sub">收送有据 · 往来有数</view>
  </view>

  <view class="panel">
    <view wx:if="{{errorMsg}}" class="alert alert-error">{{errorMsg}}</view>
    <view wx:if="{{notice}}" class="alert alert-ok">{{notice}}</view>

    <!-- 微信一键登录 -->
    <block wx:if="{{mode === 'wechat'}}">
      <button class="btn-primary" bindtap="onWechatLogin" loading="{{busy}}" disabled="{{busy}}">
        微信一键登录
      </button>
      <view class="link" bindtap="switchToPhone">使用手机号登录</view>
      <view class="tips">登录后账本会同步到云端，换手机也不会丢。</view>
    </block>

    <!-- 手机号 + 短信验证码 -->
    <block wx:else>
      <view class="field">
        <view class="field-label">手机号</view>
        <view class="phone-row">
          <view class="phone-prefix">+86</view>
          <input
            class="field-input phone-input"
            type="number"
            maxlength="11"
            value="{{phone}}"
            placeholder="11 位手机号"
            placeholder-class="field-placeholder"
            bindinput="onPhoneInput"
          />
        </view>
      </view>

      <view class="field">
        <view class="field-label">验证码</view>
        <view class="code-row">
          <input
            class="field-input code-input"
            type="number"
            maxlength="6"
            value="{{code}}"
            placeholder="6 位验证码"
            placeholder-class="field-placeholder"
            bindinput="onCodeInput"
          />
          <view
            class="code-btn {{(countdown > 0 || sending) ? 'code-btn-off' : ''}}"
            bindtap="onSendCode"
          >{{countdown > 0 ? countdown + 's' : '获取验证码'}}</view>
        </view>
      </view>

      <button
        class="btn-primary submit"
        bindtap="onSubmitOtp"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >登录 / 注册</button>
      <view class="tips">未注册的手机号会自动创建账号</view>

      <view class="divider"></view>
      <view class="link" bindtap="switchToWechat">改用微信一键登录</view>
    </block>
  </view>
</view>
